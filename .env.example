# Database: use Turso in production, or a local SQLite file for development.
DATABASE_URL=file:/app/data/wf.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional email notifications
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Optional production-level cron secret.
# A DB-stored secret can also be created from WebinarFlow → Settings → Secure cron.
CRON_SECRET=

# The application stores Telegram/MTS API credentials in Settings.
# Do not put these secrets into source control.
